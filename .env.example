# spotify web api (used for playlist lookup only, NOT audio features)
# get these at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# aws (for s3 model checkpoint upload; optional ec2/sagemaker endpoint)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
MODEL_BUCKET=music-recommender-models

# inference endpoint (filled in after deployment; used by streamlit demo)
INFERENCE_URL=
